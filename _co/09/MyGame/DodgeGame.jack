/** 閃避遊戲主控制器 */
class DodgeGame {
    field Player player;     // 玩家物件
    field int obsX, obsY;    // 障礙物座標
    field int obsSize;       // 障礙物大小
    field int score;         // 目前分數
    field boolean exit;      // 遊戲結束旗標

    /** 初始化遊戲狀態 */
    constructor DodgeGame new() {
        // 螢幕解析度為 512x256，將玩家放在底部中央
        let player = Player.new(246, 220, 20);
        let obsSize = 16;
        let obsX = 240;
        let obsY = 20;
        let score = 0;
        let exit = false;

        // 初始化顯示分數
        do Output.moveCursor(0, 0);
        do Output.printString("Score: 0");
        return this;
    }

    /** 釋放記憶體 */
    method void dispose() {
        do player.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** 繪製或擦除障礙物 */
    method void drawObstacle(boolean color) {
        do Screen.setColor(color);
        do Screen.drawRectangle(obsX, obsY, obsX + obsSize, obsY + obsSize);
        return;
    }

    /** 更新障礙物位置與分數 */
    method void updateObstacle() {
        do drawObstacle(false); // 擦除舊位置
        let obsY = obsY + 4;    // 往下掉落

        // 若障礙物掉出螢幕底部，重置到上方新位置並加分
        if ((obsY + obsSize) > 250) {
            let obsY = 20;
            let score = score + 1;

            // 利用簡單的偽隨機公式改變下一次掉落的 X 座標 (範圍約 20 ~ 470)
            let obsX = obsX + 137;
            if (obsX > 470) {
                let obsX = obsX - 450;
            }

            // 更新左上角分數顯示
            do Output.moveCursor(0, 7);
            do Output.printInt(score);
        }

        do drawObstacle(true); // 畫出新位置
        return;
    }

    /** 檢查玩家與障礙物是否碰撞 */
    method boolean checkCollision() {
        var int pX, pY, pSize;
        let pX = player.getX();
        let pY = player.getY();
        let pSize = player.getSize();

        // 矩形重疊判定 (AABB)
        if ((pX < (obsX + obsSize)) & ((pX + pSize) > obsX) &
            (pY < (obsY + obsSize)) & ((pY + pSize) > obsY)) {
            return true;
        }
        return false;
    }

    /** 遊戲主迴圈 */
    method void run() {
        var char key;

        while (~exit) {
            // 1. 讀取目前按下的鍵盤按鍵 (0 表示無按鍵)
            let key = Keyboard.keyPressed();

            if (key = 81)  { let exit = true; }     // 'Q' 鍵離開
            if (key = 130) { do player.moveLeft(); }  // 左方向鍵
            if (key = 132) { do player.moveRight(); } // 右方向鍵

            // 2. 更新障礙物並重繪玩家（避免擦除障礙物時連帶擦掉玩家邊緣）
            do updateObstacle();
            do player.draw();

            // 3. 檢查是否撞到障礙物
            if (checkCollision()) {
                let exit = true;
            }

            // 4. 控制遊戲速度（暫停 15 毫秒）
            do Sys.wait(15);
        }

        // 顯示遊戲結束訊息
        do Output.moveCursor(10, 27);
        do Output.printString("GAME OVER!");
        return;
    }
}